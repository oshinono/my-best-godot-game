[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/cat_card.gd" id="1_r"]

[node name="CatCard" type="PanelContainer"]
script = ExtResource("1_r")
size_flags_horizontal = 3
theme_type_variation = &"ListCard"

[node name="Slot" type="Control" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Letter" type="Label" parent="Slot"]
unique_name_in_owner = true
layout_mode = 1
anchor_bottom = 1.0
offset_left = -71.0
offset_top = -16.0
offset_right = -19.0
offset_bottom = 16.0
grow_vertical = 2
theme_type_variation = &"TitleLabel"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyLabel"
autowrap_mode = 3

[node name="MetaRow" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Stars" type="Label" parent="Column/MetaRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_colors/font_color = Color(0.753, 0.337, 0.129, 1)

[node name="Status" type="Label" parent="Column/MetaRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HintLabel"
autowrap_mode = 3

[node name="Story" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HintLabel"
theme_override_font_sizes/font_size = 16
autowrap_mode = 3
